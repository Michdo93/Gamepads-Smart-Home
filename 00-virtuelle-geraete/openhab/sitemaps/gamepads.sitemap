// Test-Sitemap: zeigt alle virtuellen Geräte und die Gamepad-Items.
// Aufruf: http://<openhab>:8080/basicui/app?sitemap=gamepads
// Frames für Items, die erst in späteren Kapiteln angelegt werden, bleiben bis dahin leer.

sitemap gamepads label="Smart Home & Gamepads" {

    Frame label="Gamepad (MQTT, Kapitel 19–21)" {
        Text      item=Gamepad_Wohnzimmer_Online
        Text      item=Gamepad_Wohnzimmer_Ereignis
        Text      item=Gamepad_Wohnzimmer_Steuerkreuz
        Switch    item=Gamepad_Wohnzimmer_Taste_A
        Text      item=Gamepad_Wohnzimmer_LX
        Text      item=Gamepad_Wohnzimmer_LY
        Text      item=Gamepad_Wohnzimmer_RT
        Text      item=Gamepad_Wohnzimmer_Farbton
        Text      item=Gamepad_Wohnzimmer_Akku
        Selection item=Gamepad_Raum mappings=[iKonferenz="Konferenzraum", iKueche="Küche", iBad="Bad",
                                              iIoT="IoT-Labor", iMultimedia="Multimedia-Raum"]
        Selection item=Gamepad_Sender mappings=[SWR3="SWR3", bigFM_BW="bigFM BW", Energy_Stuttgart="Energy Stuttgart",
                                                Radio_Regenbogen="Radio Regenbogen", Antenne1="Antenne 1", DASDING="DASDING"]
    }

    Frame label="Licht (Hue)" {
        Switch      item=iSmartHome_Hue_Lampen_Schalter
        Slider      item=iSmartHome_Hue_Lampen_Helligkeit
        Slider      item=iSmartHome_Hue_Lampen_Farbtemperatur
        Colorpicker item=iSmartHome_Hue_Lampen_Farbe
        Switch      item=gLichter
    }

    Frame label="Rollladen und Jalousie" {
        Switch item=iSmartHome_Somfy_Rollladen_Steuerung
        Switch item=iSmartHome_Jalousie_Steuerung
        Slider item=iSmartHome_Jalousie_Lamelle
        Switch item=iMultimedia_Somfy_Rollladen_Steuerung
    }

    Frame label="Webradio und Lautstärke" {
        Text item=gWebradio
        Group item=iKonferenz_Sonos_Playbar
        Group item=iKueche_Sonos_Lautsprecher
        Group item=iBad_Sonos_Lautsprecher
        Group item=iIoT_Sonos_Lautsprecher
        Group item=iMultimedia_Sonos_Lautsprecher
    }

    Frame label="Multimedia" {
        Switch item=iMultimedia_Samsung_TV_Power
        Text   item=iMultimedia_Samsung_TV_Taste
        Slider item=iMultimedia_Samsung_TV_Lautstaerke
        Switch item=iMultimedia_Beamer_Power
    }

    Frame label="Kamera, Routinen, Hinweise" {
        Text   item=iIoT_Kamera_PTZ
        Text   item=iIoT_Kamera_Zoom
        Switch item=iApplikation_Morgenroutine_Start
        Switch item=iApplikation_Morgenroutine_Ausgangszustand
        Switch item=iSmartHome_Klingel
        Switch item=iSmartHome_Alarm
    }
}
